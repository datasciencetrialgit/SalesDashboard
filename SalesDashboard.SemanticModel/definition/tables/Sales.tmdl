		sourceColumn: Product

	column Units
		dataType: int64
		formatString: 0
		lineageTag: c95c88ee-ed25-4728-bc26-7e51c35b21f8
		summarizeBy: sum
		sourceColumn: Units

	column Revenue
		dataType: double
		formatString: $#,0.00
		lineageTag: 115f5425-ffaa-445d-8d49-110fa964ec93
		summarizeBy: sum
		sourceColumn: Revenue

	column Cost
		dataType: double
		formatString: $#,0.00
