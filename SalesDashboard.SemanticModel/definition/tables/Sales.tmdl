	column 'Month Start' = DATE(YEAR(Sales[OrderDate]), MONTH(Sales[OrderDate]), 1)
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: f84d2f4e-1b7c-405d-a7d9-8d8935bb0a27
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 775c2588-eb97-4b9b-8caf-5a0ee0ed4fa4
			defaultHierarchy: LocalDateTable_180d6482-b86f-42fb-8a58-1696a3c9b7b0.'Date Hierarchy'

	partition Sales = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("C:/Users/datas/Downloads/SalesDashboard-PBIP/SalesDashboard/data/sales.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
						{"OrderDate", type date},
						{"OrderID", type text},
						{"Region", type text},
						{"Salesperson", type text},
						{"Category", type text},
						{"Product", type text},
						{"Units", Int64.Type},
						{"Revenue", type number},
						{"Cost", type number}
					})
				in
					ChangedTypes

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

