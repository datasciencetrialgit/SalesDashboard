{
  "$schema": "../config/powerbi-project.schema.json",
  "schemaVersion": "1.0",
  "project": {
    "name": "AnalyticsStarter",
    "displayName": "Analytics Starter",
    "description": "A complete generic manifest example for a local imported semantic model and one report.",
    "domain": "Demo",
    "ownerTeam": "Analytics"
  },
  "artifacts": {
    "semanticModel": {
      "kind": "local",
      "format": "TMDL",
      "storageMode": "Import",
      "remoteConnection": null
    },
    "reports": [
      { "name": "AnalyticsStarter", "format": "PBIR", "semanticModel": "local" }
    ]
  },
  "connections": [
    {
      "name": "PrimarySource",
      "kind": "sql-server",
      "location": "server/database",
      "authentication": "configured-outside-source-control",
      "privacyLevel": "Organizational",
      "gatewayRequired": true,
      "requiresAbsoluteLocalPath": false,
      "parameters": ["Server", "Database"]
    }
  ],
  "model": {
    "tables": [],
    "relationships": [],
    "measures": [],
    "calculationGroups": [],
    "perspectives": [],
    "cultures": ["en-US"],
    "dateTable": null,
    "incrementalRefreshPolicies": []
  },
  "report": {
    "theme": "templates/neutral-theme.json",
    "pages": [],
    "bookmarks": [],
    "mobileLayouts": false,
    "accessibility": {
      "requireAltText": true,
      "requireTabOrder": true,
      "minimumContrast": "WCAG-AA"
    }
  },
  "security": {
    "rlsRoles": [],
    "ols": [],
    "sensitivityLabel": null,
    "certificationTarget": null
  },
  "deployment": {
    "strategy": "manual",
    "environments": [
      { "name": "Development", "workspace": null, "parameters": {} },
      { "name": "Test", "workspace": null, "parameters": {} },
      { "name": "Production", "workspace": null, "parameters": {} }
    ]
  },
  "quality": {
    "requireDesktopRoundTrip": true,
    "requireMeasureTests": true,
    "requireAccessibilityReview": true,
    "requireSecurityReview": true,
    "maxVisualsPerPage": 12,
    "targetVisualRenderMs": 3000,
    "targetRefreshMinutes": 30
  },
  "extensions": []
}
